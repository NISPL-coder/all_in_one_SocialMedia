# ----------------------------------------------------------------------------
# SocialHub Unified Social Media Publishing Dashboard - Environment Config
# ----------------------------------------------------------------------------

# Server & Client URLs
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# MongoDB Database Connection (Local or MongoDB Atlas Cloud)
DATABASE_URL=mongodb://localhost:27017/socialhub
# For MongoDB Atlas cloud database, format is:
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/socialhub?retryWrites=true&w=majority

# Redis Connection (BullMQ background queue)
REDIS_URL=redis://localhost:6379

# Security & Encryption (Generate a random 32-character key for AES-256-GCM)
SESSION_SECRET=super_secret_session_key_minimum_32_characters_random_string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_key_for_api_tokens_change_in_production

# Admin Initial Credentials (for database seed)
INITIAL_ADMIN_EMAIL=admin@socialhub.local
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_NAME="SocialHub Administrator"

# Uploads Base URL
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# 1. LinkedIn API (OAuth 2.0 & Community Management API)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/accounts/linkedin/callback

# 2. Meta (Facebook Pages & Instagram Professional)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:4000/api/accounts/facebook/callback
META_INSTAGRAM_REDIRECT_URI=http://localhost:4000/api/accounts/instagram/callback

# 3. WhatsApp Business Platform / Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_secret_verification_token
WHATSAPP_API_VERSION=v21.0

# 4. Google Business Profile API (Google Cloud OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_cloud_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_cloud_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/accounts/google_business/callback

# 5. AI Content Assistant (OpenAI / Anthropic / Gemini API)
AI_API_KEY=your_ai_provider_api_key
AI_PROVIDER=gemini # 'gemini' | 'openai'
AI_MODEL=gemini-2.5-flash
